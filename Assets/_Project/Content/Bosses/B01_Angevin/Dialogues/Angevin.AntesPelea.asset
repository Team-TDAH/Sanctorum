  m_Script: {fileID: 11500000, guid: 93f1c3ac0e4bb524b9db04ffc6da360d, type: 3}
  m_Name: Angevin.AntesPelea
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  participants:
  - speakerName: Angevin
    portrait: {fileID: -4908389164697428566, guid: fc3a95821aab6054796b5e04eb6771e1, type: 3}
    side: 1
  lines:
  - isMiharu: 0
    participantIndex: 0
    text: "A\xFAn no ha llegado tu hora de cruzar este r\xEDo, Miharu."
  - isMiharu: 1
    participantIndex: 0
    text: "\xBFSabes quien soy?"
  - isMiharu: 0
    participantIndex: 0
    text: "Conozco a todos los que pasan por aqu\xED"
  - isMiharu: 1
    participantIndex: 0
    text: Entonces sabes que tengo que cruzar para rescatar a mi hijo, Tojiro.
  - isMiharu: 0
    participantIndex: 0
    text: "Demuestrame que puedes hacerlo y te dejar\xE9 cruzar hasta Sanctorum."
