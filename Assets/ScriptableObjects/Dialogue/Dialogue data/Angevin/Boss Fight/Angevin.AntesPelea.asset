  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 93f1c3ac0e4bb524b9db04ffc6da360d, type: 3}
  m_Name: Angevin.AntesPelea
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  participants:
  - speakerName: Angevin
    portrait: {fileID: -4908389164697428566, guid: fc3a95821aab6054796b5e04eb6771e1, type: 3}
    side: 1
  lines:
  - isMiharu: 0
    participantIndex: 0
    text: "A\xFAn no ha llegado tu hora de cruzar este r\xEDo."
  - isMiharu: 1
    participantIndex: 0
    text: Tengo que rescatar a mi hijo.
  - isMiharu: 0
    participantIndex: 0
    text: ' Lamento escuchar que una madre y su hijo sean separados por las vicisitudes
      de la vida, pero a veces el destino de uno es sufrir los golpes y flechas de
      la ultrajante fortuna.

'
  - isMiharu: 1
    participantIndex: 0
    text: "Mi destino es el que yo elija, cruzar\xE9 con tu bendici\xF3n o sin ella."
  - isMiharu: 0
    participantIndex: 0
    text: "Si esa es tu elecci\xF3n, derrotame en un duelo y te dejar\xE9 cruzar."
