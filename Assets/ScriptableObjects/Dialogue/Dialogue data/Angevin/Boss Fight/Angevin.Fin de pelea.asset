  m_Script: {fileID: 11500000, guid: 93f1c3ac0e4bb524b9db04ffc6da360d, type: 3}
  m_Name: Angevin.Fin de pelea
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  npcPortrait: {fileID: 21300000, guid: 334e488b26a4eec45a7790da69dc6fe4, type: 2}
  lines:
  - speaker: 0
    text: 
    speakerName: 
  - speaker: 1
    text: "Veo que te protege un dios. Me has vencido en un duelo, te dejar\xE9 pasar."
    speakerName: Angevin
  - speaker: 1
    text: "Ten cuidado mortal no te imaginas los que te esperan m\xE1s all\xE1 de
      esta orilla."
    speakerName: Angevin
  - speaker: 0
    text: "Tengo que hacerlo, promet\xED a mi esposo que pase lo que pase proteger\xEDa
      a nuestro hijo."
    speakerName: iharu
  - speaker: 1
    text: "Entonces toma esta moneda. Ponla en agua y acudir\xE9 en tu ayuda."
    speakerName: Angevin
